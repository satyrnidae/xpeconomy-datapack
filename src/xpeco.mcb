import ./config.js

function load minecraft:load {
    # Trigger objectives from before the rename. Removing one that does not exist just fails, so this is safe every load.
    scoreboard objectives remove xpeco.balance
    scoreboard objectives remove xpeco.pay
    scoreboard objectives remove xpeco.request
    scoreboard objectives remove xpeco.reply
    scoreboard objectives remove accept_charges
    scoreboard objectives remove decline_payment

    # Shared objectives. Each feature file defines its own beside its functions.
    scoreboard objectives add xpeco.tmp dummy
    scoreboard objectives add xpeco.cfg dummy

    # Constants
    scoreboard players set #2 xpeco.tmp 2
    scoreboard players set #5 xpeco.tmp 5
    scoreboard players set #6 xpeco.tmp 6
    scoreboard players set #9 xpeco.tmp 9
    scoreboard players set #81 xpeco.tmp 81
    scoreboard players set #100 xpeco.tmp 100
    scoreboard players set #325 xpeco.tmp 325
    scoreboard players set #720 xpeco.tmp 720
    scoreboard players set #4440 xpeco.tmp 4440

    # Display mode: 0 points, 1 levels, 2 per hundred. Only set when unset so /reload keeps it.
    execute unless score #mode xpeco.cfg = #mode xpeco.cfg run scoreboard players set #mode xpeco.cfg 0

    # Request lifetime in ticks from config.json, 600 is 30 seconds. Only set when unset so /reload keeps an edited value.
    execute unless score #expire xpeco.cfg = #expire xpeco.cfg run scoreboard players set #expire xpeco.cfg <%config.expireTicks%>
}

# Removes everything the pack created, then disables it. Run as an operator: /function xpeco:uninstall
# Offline pending credits live in xpeco.pending and are discarded with it.
function uninstall {
    tellraw @s {text:"Uninstalling Experience Economy v<%config.version%>..."}

    # Each feature file removes its own objectives and tags through this tag
    function #xpeco:on_uninstall

    data remove storage xpeco:tmp amount

    execute store success score #uninstall xpeco.cfg run datapack disable "file/<%config.packName%>"
    execute unless score #uninstall xpeco.cfg matches 1 run tellraw @s [{text:"Pack folder name has changed. ",color:"red"},{text:"Finish with /datapack disable \"file/<pack folder>\"",color:"aqua"}]
    execute if score #uninstall xpeco.cfg matches 1 run tellraw @s {text:"Experience Economy uninstalled.",color:"green"}

    scoreboard objectives remove xpeco.tmp
    scoreboard objectives remove xpeco.cfg
}

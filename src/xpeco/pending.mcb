import ../config.js

function load minecraft:load {
    scoreboard objectives add xpeco.pending dummy
}

function on_uninstall xpeco:on_uninstall {
    scoreboard objectives remove xpeco.pending
}

function apply {
    # As a player with a non-zero pending score
    execute store result storage xpeco:tmp amount int 1 run scoreboard players get @s xpeco.pending
    function xpeco:pending/apply_macro with storage xpeco:tmp
    scoreboard players set @s xpeco.pending 0
}

function apply_macro {
    $experience add @s $(amount) points
}

function tick minecraft:tick {
    # Offline ledger: holder is the player name, so an online player's own score is the same entry
    execute as @a[scores={xpeco.pending=1..}] run function xpeco:pending/apply
    execute as @a[scores={xpeco.pending=..-1}] run function xpeco:pending/apply
}

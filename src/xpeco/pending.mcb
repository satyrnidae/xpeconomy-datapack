import ../config.js
import predicate.js

function load minecraft:load {
    scoreboard objectives add xpeco.pending dummy
}

function uninstall xpeco:uninstall {
    scoreboard objectives remove xpeco.pending
}

function apply {
    # As a player with a non-zero pending score
    execute store result storage xpeco:tmp amount int 1 run scoreboard players get @s xpeco.pending
    function xpeco:pending/apply_macro with storage xpeco:tmp
    scoreboard players set @s xpeco.pending 0
}

function apply_macro {
    $experience add @s $(amount) points
}

# Offline ledger: holder is the player name, so an online player's own score is the same entry. Owed means a score that
# is not zero, positive for a credit and negative for a debit, so one predicate covers both.
predicate owed {
    <%nonzero(['xpeco.pending'])%>
}

function tick xpeco:tick {
    execute if score #n20 xpeco.tmp matches 0 as @a[predicate=xpeco:pending/owed] run function xpeco:pending/apply
}

import ../../text/pay.js
import ../predicate.js
# Handlers for the xpeco.pay_* triggers behind the chat buttons, and the tick that enables and dispatches them.

function on_to {
    # As a player who clicked a name. The score is the account id.
    scoreboard players operation #to xpeco.tmp = @s xpeco.pay_to
    scoreboard players set @s xpeco.pay_to 0
    execute unless function xpeco:paylist/fresh run return 0
    execute if score #to xpeco.tmp = @s xpeco.account run return run tellraw @s <%payText.self%>
    scoreboard players operation @s xpeco.pay.to = #to xpeco.tmp
    function xpeco:paylist/confirm/prompt
}

function on_page {
    scoreboard players operation @s xpeco.pay.page = @s xpeco.pay_page
    scoreboard players set @s xpeco.pay_page 0
    execute unless function xpeco:paylist/fresh run return 0
    function xpeco:paylist/list/show
}

function on_confirm {
    scoreboard players set @s xpeco.pay_confirm 0
    scoreboard players set @s xpeco.pay_deny 0
    execute unless function xpeco:paylist/fresh run return 0
    execute unless score @s xpeco.pay.to matches 1.. run return run tellraw @s <%payText.nopick%>
    scoreboard players operation #amt xpeco.tmp = @s xpeco.pay.amt
    scoreboard players operation #to xpeco.tmp = @s xpeco.pay.to
    function xpeco:paylist/clear
    tag @a remove xpeco.target
    execute as @a if score @s xpeco.account = #to xpeco.tmp run tag @s add xpeco.target
    execute if entity @a[tag=xpeco.target] run function xpeco:pay/transfer
    execute unless entity @a[tag=xpeco.target] run function xpeco:pay/offline
    tag @a remove xpeco.target
}

function on_deny {
    scoreboard players set @s xpeco.pay_deny 0
    execute unless score @s xpeco.pay.amt matches 1.. run return run tellraw @s <%payText.none%>
    function xpeco:paylist/clear
    tellraw @s <%payText.denied%>
}

# A button player has clicked leaves its trigger score above zero. One predicate finds those players, so an idle tick is a
# single scan, and dispatch runs the handler of each trigger that is set. A negative score came from a typed command, so it
# is just reset.
predicate fired {
    <%nonzero(['xpeco.pay_to', 'xpeco.pay_page', 'xpeco.pay_confirm', 'xpeco.pay_deny', 'xpeco.req_to', 'xpeco.req_page'])%>
}

function dispatch {
    REPEAT (['to', 'page', 'confirm', 'deny']) as t {
        execute if score @s xpeco.pay_<%t%> matches 1.. run function xpeco:paylist/triggers/on_<%t%>
        execute if score @s xpeco.pay_<%t%> matches ..-1 run scoreboard players set @s xpeco.pay_<%t%> 0
    }
    # The request list buttons. Their handlers are in request.
    REPEAT (['to', 'page']) as t {
        execute if score @s xpeco.req_<%t%> matches 1.. run function xpeco:request/on_<%t%>
        execute if score @s xpeco.req_<%t%> matches ..-1 run scoreboard players set @s xpeco.req_<%t%> 0
    }
}

function tick xpeco:tick {
    execute as @a[predicate=xpeco:paylist/triggers/fired] run function xpeco:paylist/triggers/dispatch
}

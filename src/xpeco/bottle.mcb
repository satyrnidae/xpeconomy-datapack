import ../config.js

# XP bottles. Options from config.json: bottlePoints, bottleReachSteps.
#
# Fill: sneak with a glass bottle in the main hand and aim at an enchanting table within reach. While that holds, an
#  interaction entity sits over the table. It is a bit bigger than the table so the ray reaches it before the block, and
#  its response makes the client treat the click as handled, so the table menu never opens. Right-clicking the entity
#  fires player_interacted_with_entity, whose reward function does the fill. When nobody who qualifies is near, the
#  entity is removed again, so tables behave normally otherwise.
#  Reach is the entity interaction range, 3 blocks, not the 4.5 block reach for blocks. bottleReachSteps are 0.25 block
#  steps along the look ray.
#  Side effects while it is there: the table cannot be broken, and other players near it get the entity click instead of
#  the menu. Creative players fill for free, nothing is deducted and no bottle is used.
#
# Throw: bottles from fill carry custom_data "xpeco:player_filled":1b. Throwing one gives no advancement trigger, only a
#  used stat, so tick finds the thrown entity by that data instead; the Item stack is copied onto it. Bottles without the
#  data are tagged xpeco.ignored on first sight so they cost no more lookups. Each one gets a
#  marker riding it. When the marker has no vehicle the bottle has landed: the vanilla orbs within 3 blocks go and
#  exactly bottlePoints of orbs, split at random, take their place. Orbs we spawn are tagged xpeco.filled_bauble and are left
#  alone, so bottles landing together do not kill each other's orbs. Orbs from other sources near the impact still go.

# Total points of a player near a bottle in flight, from the last tick
function load minecraft:load {
    scoreboard objectives add xpeco.bottle_prev dummy
}

function on_uninstall xpeco:on_uninstall {
    scoreboard objectives remove xpeco.bottle_prev
    kill @e[type=minecraft:marker,tag=xpeco.bottle_tracker]
    tag @e[type=minecraft:experience_bottle] remove xpeco.tracked_bottle
    tag @e[type=minecraft:experience_bottle] remove xpeco.ignored
    tag @e[type=minecraft:experience_orb] remove xpeco.filled_bauble
    kill @e[type=minecraft:interaction,tag=xpeco.bottle.table]
    advancement revoke @a only xpeco:bottle/on_interact
}

# Sneaking with a glass bottle in the main hand
predicate ready {
    "type": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "minecraft:flags": {
            "is_sneaking": true
        },
        "minecraft:equipment": {
            "mainhand": {
                "items": "minecraft:glass_bottle"
            }
        }
    }
}

advancement on_interact {
    "criteria": {
        "use": {
            "trigger": "minecraft:player_interacted_with_entity",
            "conditions": {
                "player": "xpeco:bottle/ready",
                "entity": {
                    "type": "minecraft:entity_properties",
                    "entity": "this",
                    "predicate": {
                        "minecraft:entity_type": "minecraft:interaction"
                    }
                }
            }
        }
    },
    "requirements": [
        [
            "use"
        ]
    ],
    "rewards": {
        "function": "xpeco:bottle/fill"
    }
}

function track {
    # As and at a player who is sneaking with a glass bottle. Looks along the eye ray for an enchanting table.
    scoreboard players set #steps xpeco.tmp <%config.bottleReachSteps%>
    execute anchored eyes positioned ^ ^ ^ run function xpeco:bottle/ray
}

function ray {
    # Same walk as the pay target ray, 0.25 block steps through blocks in #xpeco:target/ray_pass
    execute if block ~ ~ ~ minecraft:enchanting_table run return run function xpeco:bottle/ensure
    scoreboard players remove #steps xpeco.tmp 1
    execute if score #steps xpeco.tmp matches 1.. if block ~ ~ ~ #xpeco:target/ray_pass positioned ^ ^ ^0.25 run function xpeco:bottle/ray
}

function ensure {
    # At a point inside the table. Puts one interaction entity over the table's block, unless it already has one.
    execute align xyz positioned ~0.5 ~ ~0.5 unless entity @e[type=minecraft:interaction,tag=xpeco.bottle.table,distance=..0.3] run summon minecraft:interaction ~ ~ ~ {width:1.1f,height:0.85f,response:true,Tags:["xpeco.bottle.table"]}
}

function fill {
    # Reward of on_interact, as the player who clicked the entity
    advancement revoke @s only xpeco:bottle/on_interact
    execute if entity @s[gamemode=creative] run return run function xpeco:bottle/give
    scoreboard players set #bottle xpeco.tmp <%config.bottlePoints%>
    function xpeco:total/compute
    execute if score @s xpeco.total < #bottle xpeco.tmp run return run tellraw @s {translate:"xpeco.bottle.lowbalance",fallback:"Not enough experience to fill a bottle, you need %s points.",with:[{score:{name:"#bottle",objective:"xpeco.tmp"}}]}
    experience add @s -<%config.bottlePoints%> points
    clear @s minecraft:glass_bottle 1
    function xpeco:bottle/give
}

function give {
    # loot give drops the bottle at the player when the inventory has no room
    loot give @s loot xpeco:bottle/filled
    playsound minecraft:item.bottle.fill player @s ~ ~ ~ 1 1
}

# One experience bottle. A loot table applies an item modifier through its root modifier key, not through a functions
# list; 26.3 has no reference function, and a bare id in functions did nothing.
loot_table filled {
    "pools": [
        {
            "rolls": 1,
            "entries": [
                {
                    "type": "minecraft:item",
                    "name": "minecraft:experience_bottle"
                }
            ]
        }
    ],
    "modifier": "xpeco:bottle/filled"
}

# Name, rarity and the marker data a filled bottle carries. custom_data goes through SNBT so the flag stays a byte.
item_modifier filled {
    "type": "minecraft:sequence",
    "functions": [
        {
            "type": "minecraft:set_components",
            "components": {
                "minecraft:item_name": {
                    "translate": "xpeco.bottle.name",
                    "fallback": "Filled Bottle o' Enchanting"
                },
                "minecraft:rarity": "common"
            }
        },
        {
            "type": "minecraft:set_custom_data",
            "tag": "{\"xpeco:player_filled\":1b}"
        }
    ]
}

# Thrown bottle whose stack came from fill
predicate player_filled {
    "type": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "minecraft:nbt": "{Item:{components:{\"minecraft:custom_data\":{\"xpeco:player_filled\":1b}}}}"
    }
}

function classify {
    # Tick, as and at each thrown bottle not seen before. One data lookup per bottle; non-matches are tagged and skipped from then on.
    execute if entity @s[predicate=xpeco:bottle/player_filled] run return run function xpeco:bottle/find_thrown
    tag @s add xpeco.ignored
}

function find_thrown {
    # Tick, as each untracked thrown bottle that came from fill
    tag @s add xpeco.tracked_bottle
    tag @s add xpeco.mount_target
    execute summon minecraft:marker run function xpeco:bottle/mount
    tag @s remove xpeco.mount_target
}

function mount {
    # As the new marker, at the bottle
    tag @s add xpeco.bottle_tracker
    ride @s mount @e[type=minecraft:experience_bottle,tag=xpeco.mount_target,limit=1,sort=nearest]
}

function check_tracker {
    # As and at a tracker. A tracker with no vehicle means the bottle has landed.
    scoreboard players set #v xpeco.tmp 0
    execute on vehicle run scoreboard players set #v xpeco.tmp 1
    execute if score #v xpeco.tmp matches 0 run return run function xpeco:bottle/landed
    # In flight. Keep the speed of the marker current, and remember the totals of players the bottle could hit.
    function xpeco:bottle/trace
    execute as @a[distance=..3] run function xpeco:bottle/snapshot
}

function snapshot {
    function xpeco:total/compute
    scoreboard players operation @s xpeco.bottle_prev = @s xpeco.total
}

function take_back {
    # As a player near the landing. A direct hit hands the player the vanilla orbs the same tick, before tick can remove
    # them, so what they gained since the last snapshot is taken back. 11 is the most a vanilla bottle gives, which keeps
    # an unrelated gain from being undone.
    function xpeco:total/compute
    scoreboard players operation #d xpeco.tmp = @s xpeco.total
    scoreboard players operation #d xpeco.tmp -= @s xpeco.bottle_prev
    execute unless score #d xpeco.tmp matches 1..11 run return 0
    execute store result storage xpeco:tmp delta int 1 run scoreboard players get #d xpeco.tmp
    function xpeco:bottle/take_back_macro with storage xpeco:tmp
}

function take_back_macro {
    $experience add @s -$(delta) points
}

function trace {
    # As the tracker. Position and speed live in the data tag of the marker, in thousandths of a block. Speed is the change
    # since the last tick, so when the bottle lands it is the speed of its last step.
    execute store result score #cx xpeco.tmp run data get entity @s Pos[0] 1000
    execute store result score #cy xpeco.tmp run data get entity @s Pos[1] 1000
    execute store result score #cz xpeco.tmp run data get entity @s Pos[2] 1000
    execute if data entity @s data.px run function xpeco:bottle/trace_speed
    execute store result entity @s data.px int 1 run scoreboard players get #cx xpeco.tmp
    execute store result entity @s data.py int 1 run scoreboard players get #cy xpeco.tmp
    execute store result entity @s data.pz int 1 run scoreboard players get #cz xpeco.tmp
}

function trace_speed {
    execute store result score #px xpeco.tmp run data get entity @s data.px
    execute store result score #py xpeco.tmp run data get entity @s data.py
    execute store result score #pz xpeco.tmp run data get entity @s data.pz
    scoreboard players operation #vx xpeco.tmp = #cx xpeco.tmp
    scoreboard players operation #vy xpeco.tmp = #cy xpeco.tmp
    scoreboard players operation #vz xpeco.tmp = #cz xpeco.tmp
    scoreboard players operation #vx xpeco.tmp -= #px xpeco.tmp
    scoreboard players operation #vy xpeco.tmp -= #py xpeco.tmp
    scoreboard players operation #vz xpeco.tmp -= #pz xpeco.tmp
    execute store result entity @s data.vx int 1 run scoreboard players get #vx xpeco.tmp
    execute store result entity @s data.vy int 1 run scoreboard players get #vy xpeco.tmp
    execute store result entity @s data.vz int 1 run scoreboard players get #vz xpeco.tmp
}

# Surface normal of the impact, in #nx #ny #nz. Vanilla uses the face that was hit for blocks and the reverse of the
# motion of the bottle for entities. A datapack gets neither, so probe a bit past the marker along each axis the bottle
# was moving on: a solid block there is the face, and the normal points back against the travel. With nothing solid found
# it was an entity hit or a graze, so use the reverse of the motion; with no motion either, up.
function normal {
    scoreboard players set #nx xpeco.tmp 0
    scoreboard players set #ny xpeco.tmp 0
    scoreboard players set #nz xpeco.tmp 0
    scoreboard players set #vx xpeco.tmp 0
    scoreboard players set #vy xpeco.tmp 0
    scoreboard players set #vz xpeco.tmp 0
    execute store result score #vx xpeco.tmp run data get entity @s data.vx
    execute store result score #vy xpeco.tmp run data get entity @s data.vy
    execute store result score #vz xpeco.tmp run data get entity @s data.vz
    # The marker trails the impact by up to a step, so the probe goes 1.1 steps ahead. Speeds under 0.02 are ignored.
    execute unless score #vx xpeco.tmp matches -19..19 run function xpeco:bottle/probe_x
    execute unless score #vy xpeco.tmp matches -19..19 run function xpeco:bottle/probe_y
    execute unless score #vz xpeco.tmp matches -19..19 run function xpeco:bottle/probe_z
    execute if score #nx xpeco.tmp matches 0 if score #ny xpeco.tmp matches 0 if score #nz xpeco.tmp matches 0 run function xpeco:bottle/normal_from_motion
}

function probe_x {
    execute store result storage xpeco:tmp dx double 0.0011 run scoreboard players get #vx xpeco.tmp
    function xpeco:bottle/probe_x_at with storage xpeco:tmp
}

function probe_x_at {
    $execute positioned ~$(dx) ~ ~ unless block ~ ~ ~ #xpeco:target/ray_pass run function xpeco:bottle/hit_x
}

function hit_x {
    execute if score #vx xpeco.tmp matches 1.. run scoreboard players set #nx xpeco.tmp -1
    execute if score #vx xpeco.tmp matches ..-1 run scoreboard players set #nx xpeco.tmp 1
}

function probe_y {
    execute store result storage xpeco:tmp dy double 0.0011 run scoreboard players get #vy xpeco.tmp
    function xpeco:bottle/probe_y_at with storage xpeco:tmp
}

function probe_y_at {
    $execute positioned ~ ~$(dy) ~ unless block ~ ~ ~ #xpeco:target/ray_pass run function xpeco:bottle/hit_y
}

function hit_y {
    execute if score #vy xpeco.tmp matches 1.. run scoreboard players set #ny xpeco.tmp -1
    execute if score #vy xpeco.tmp matches ..-1 run scoreboard players set #ny xpeco.tmp 1
}

function probe_z {
    execute store result storage xpeco:tmp dz double 0.0011 run scoreboard players get #vz xpeco.tmp
    function xpeco:bottle/probe_z_at with storage xpeco:tmp
}

function probe_z_at {
    $execute positioned ~ ~ ~$(dz) unless block ~ ~ ~ #xpeco:target/ray_pass run function xpeco:bottle/hit_z
}

function hit_z {
    execute if score #vz xpeco.tmp matches 1.. run scoreboard players set #nz xpeco.tmp -1
    execute if score #vz xpeco.tmp matches ..-1 run scoreboard players set #nz xpeco.tmp 1
}

function normal_from_motion {
    scoreboard players operation #nx xpeco.tmp -= #vx xpeco.tmp
    scoreboard players operation #ny xpeco.tmp -= #vy xpeco.tmp
    scoreboard players operation #nz xpeco.tmp -= #vz xpeco.tmp
    execute if score #nx xpeco.tmp matches 0 if score #ny xpeco.tmp matches 0 if score #nz xpeco.tmp matches 0 run scoreboard players set #ny xpeco.tmp 1
}

function landed {
    # As and at a tracker whose bottle is gone
    execute as @a[distance=..3,scores={xpeco.bottle_prev=0..}] run function xpeco:bottle/take_back
    # Orbs from other bottles of ours carry xpeco.filled_bauble and stay
    kill @e[type=minecraft:experience_orb,tag=!xpeco.filled_bauble,distance=..3]
    function xpeco:bottle/normal
    scoreboard players set #left xpeco.tmp <%config.bottlePoints%>
    function xpeco:bottle/orb_next
    kill @s
}

function orb_next {
    # Takes a random 1..#left share, spawns it, repeats until #left is spent
    execute store result score #r xpeco.tmp run random value 1..1000
    scoreboard players operation #r xpeco.tmp %= #left xpeco.tmp
    scoreboard players add #r xpeco.tmp 1
    scoreboard players operation #left xpeco.tmp -= #r xpeco.tmp
    execute store result storage xpeco:tmp value int 1 run scoreboard players get #r xpeco.tmp
    # Motion as the vanilla orb constructor rolls it: x and z within 0.2, y 0 to 0.4, flipped when it points into the surface
    execute store result score #rx xpeco.tmp run random value -2000..2000
    execute store result score #ry xpeco.tmp run random value 0..4000
    execute store result score #rz xpeco.tmp run random value -2000..2000
    function xpeco:bottle/orient
    execute store result storage xpeco:tmp mx double 0.0001 run scoreboard players get #rx xpeco.tmp
    execute store result storage xpeco:tmp my double 0.0001 run scoreboard players get #ry xpeco.tmp
    execute store result storage xpeco:tmp mz double 0.0001 run scoreboard players get #rz xpeco.tmp
    function xpeco:bottle/orb with storage xpeco:tmp
    execute if score #left xpeco.tmp matches 1.. run function xpeco:bottle/orb_next
}

function orient {
    # Dot product of the roll with the normal; a negative one points into the surface, so negate the whole roll
    scoreboard players operation #dot xpeco.tmp = #rx xpeco.tmp
    scoreboard players operation #dot xpeco.tmp *= #nx xpeco.tmp
    scoreboard players operation #t xpeco.tmp = #ry xpeco.tmp
    scoreboard players operation #t xpeco.tmp *= #ny xpeco.tmp
    scoreboard players operation #dot xpeco.tmp += #t xpeco.tmp
    scoreboard players operation #t xpeco.tmp = #rz xpeco.tmp
    scoreboard players operation #t xpeco.tmp *= #nz xpeco.tmp
    scoreboard players operation #dot xpeco.tmp += #t xpeco.tmp
    execute if score #dot xpeco.tmp matches ..-1 run function xpeco:bottle/flip
}

function flip {
    scoreboard players set #t xpeco.tmp 0
    scoreboard players operation #t xpeco.tmp -= #rx xpeco.tmp
    scoreboard players operation #rx xpeco.tmp = #t xpeco.tmp
    scoreboard players set #t xpeco.tmp 0
    scoreboard players operation #t xpeco.tmp -= #ry xpeco.tmp
    scoreboard players operation #ry xpeco.tmp = #t xpeco.tmp
    scoreboard players set #t xpeco.tmp 0
    scoreboard players operation #t xpeco.tmp -= #rz xpeco.tmp
    scoreboard players operation #rz xpeco.tmp = #t xpeco.tmp
}

function orb {
    $summon minecraft:experience_orb ~ ~ ~ {Value:$(value),Motion:[$(mx),$(my),$(mz)],Tags:["xpeco.filled_bauble"]}
}

function tick minecraft:tick {
    execute as @a[predicate=xpeco:bottle/ready] at @s run function xpeco:bottle/track
    execute as @e[type=minecraft:experience_bottle,tag=!xpeco.tracked_bottle,tag=!xpeco.ignored] at @s run function xpeco:bottle/classify
    execute as @e[type=minecraft:marker,tag=xpeco.bottle_tracker] at @s run function xpeco:bottle/check_tracker
    execute as @e[type=minecraft:interaction,tag=xpeco.bottle.table] at @s unless entity @a[predicate=xpeco:bottle/ready,distance=..6] run kill @s
    execute as @a[scores={xpeco.bottle_prev=0..}] at @s unless entity @e[type=minecraft:marker,tag=xpeco.bottle_tracker,distance=..4] run scoreboard players reset @s xpeco.bottle_prev
}

import ../text/bottle.js
import ../config.js

# XP bottles. Options from mcb.config.js: bottlePoints, bottleReachSteps. bottlePoints is the default of #bottlepoints
# xpeco.cfg, set on first load only, so /scoreboard players set #bottlepoints xpeco.cfg <n> changes it at runtime, a value under 1 is raised to 1.
#
# The files under bottle/: table for the interaction entity over an enchanting table, item for what a filled bottle is,
# mode for swapping throw and drink by sneak state, use for consuming it, thrown for tracking a thrown one, normal for its
# impact normal. The replacement orbs come from orbs. Fill and give stay here. Creative players
# fill for free, nothing is deducted and no bottle is used.

function load minecraft:load {
    execute unless score #bottlepoints xpeco.cfg = #bottlepoints xpeco.cfg run scoreboard players set #bottlepoints xpeco.cfg <%config.bottlePoints%>
}

function clamp {
    # A value under 1 would fill empty bottles or take XP away, so it is raised to 1 wherever the value is used
    execute if score #bottlepoints xpeco.cfg matches ..0 run scoreboard players set #bottlepoints xpeco.cfg 1
}

function fill {
    # Reward of on_interact, as the player who clicked the entity
    advancement revoke @s only xpeco:bottle/table/on_interact
    execute if entity @s[gamemode=creative] run return run function xpeco:bottle/give
    function xpeco:bottle/clamp
    scoreboard players operation #bottle xpeco.tmp = #bottlepoints xpeco.cfg
    function xpeco:total/compute
    execute if score @s xpeco.total < #bottle xpeco.tmp run return run tellraw @s <%bottleText.lowBalance%>
    execute store result storage xpeco:tmp points int 1 run scoreboard players get #bottlepoints xpeco.cfg
    function xpeco:bottle/take with storage xpeco:tmp
    clear @s minecraft:glass_bottle 1
    function xpeco:bottle/give
}

function take {
    $experience add @s -$(points) points
}

function give {
    # loot give drops the bottle at the player when the inventory has no room
    loot give @s loot xpeco:bottle/item/filled
    playsound minecraft:item.bottle.fill player @s ~ ~ ~ 1 1
}

import ../../config.js

# Throw: bottles from fill carry custom_data "xpeco:player_filled":1b. Throwing one gives no advancement trigger, only a
#  used stat, so tick finds the thrown entity by that data instead; the Item stack is copied onto it. Bottles without the
#  data are tagged xpeco.ignored on first sight so they cost no more lookups. Each one gets a marker riding it. When the
#  marker has no vehicle the bottle has landed: the vanilla orbs within 3 blocks go and exactly bottlePoints of orbs,
#  split at random, take their place. Orbs we spawn are tagged xpeco.orb and are left alone, so bottles landing
#  together do not kill each other's orbs. Orbs from other sources near the impact still go.

# Total points of a player near a bottle in flight, from the last tick
function load minecraft:load {
    scoreboard objectives add xpeco.bottle_prev dummy
    REPEAT (['xpeco.trace_px', 'xpeco.trace_py', 'xpeco.trace_pz', 'xpeco.trace_vx', 'xpeco.trace_vy', 'xpeco.trace_vz']) as o {
        scoreboard objectives add <%o%> dummy
    }
}

function uninstall xpeco:uninstall {
    scoreboard objectives remove xpeco.bottle_prev
    REPEAT (['xpeco.trace_px', 'xpeco.trace_py', 'xpeco.trace_pz', 'xpeco.trace_vx', 'xpeco.trace_vy', 'xpeco.trace_vz']) as o {
        scoreboard objectives remove <%o%>
    }
    kill @e[type=minecraft:marker,tag=xpeco.bottle_tracker]
    tag @e[type=minecraft:experience_bottle] remove xpeco.tracked_bottle
    tag @e[type=minecraft:experience_bottle] remove xpeco.ignored
}

function classify {
    # Tick, as and at each thrown bottle not seen before. One data lookup per bottle; non-matches are tagged and skipped from then on.
    execute if entity @s[predicate=xpeco:bottle/item/player_filled] run return run function xpeco:bottle/thrown/find_thrown
    tag @s add xpeco.ignored
}

function find_thrown {
    # Tick, as each untracked thrown bottle that came from fill
    tag @s add xpeco.tracked_bottle
    tag @s add xpeco.mount_target
    execute summon minecraft:marker run function xpeco:bottle/thrown/mount
    tag @s remove xpeco.mount_target
}

function mount {
    # As the new marker, at the bottle
    tag @s add xpeco.bottle_tracker
    ride @s mount @e[type=minecraft:experience_bottle,tag=xpeco.mount_target,limit=1,sort=nearest]
}

function check_tracker {
    # As and at a tracker. A tracker with no vehicle means the bottle has landed.
    scoreboard players set #v xpeco.tmp 0
    execute on vehicle run scoreboard players set #v xpeco.tmp 1
    execute if score #v xpeco.tmp matches 0 run return run function xpeco:bottle/thrown/landed
    # In flight. Keep the speed of the marker current, and remember the totals of players the bottle could hit.
    function xpeco:bottle/thrown/trace
    # Only a player within 2 blocks can be handed the orbs on landing, so only they are snapshotted
    execute as @a[distance=..2] run function xpeco:bottle/thrown/snapshot
}

function snapshot {
    function xpeco:total/compute
    scoreboard players operation @s xpeco.bottle_prev = @s xpeco.total
}

function take_back {
    # As a player near the landing. A direct hit hands the player the vanilla orbs the same tick, before tick can remove
    # them, so what they gained since the last snapshot is taken back. 11 is the most a vanilla bottle gives, which keeps
    # an unrelated gain from being undone.
    function xpeco:total/compute
    eq #d xpeco.tmp = @s xpeco.total - @s xpeco.bottle_prev
    execute unless score #d xpeco.tmp matches 1..11 run return 0
    execute store result storage xpeco:tmp delta int 1 run scoreboard players get #d xpeco.tmp
    function xpeco:bottle/thrown/take_back_macro with storage xpeco:tmp
}

function take_back_macro {
    $experience add @s -$(delta) points
}

function trace {
    # As the tracker. Position and speed are scores on the marker, in thousandths of a block, so the only entity NBT read per
    # tick is the position. Speed is the change
    # since the last tick, so when the bottle lands it is the speed of its last step.
    REPEAT ({x: 0, y: 1, z: 2}) as a, i {
        execute store result score #c<%a%> xpeco.tmp run data get entity @s Pos[<%i%>] 1000
    }
    execute if score @s xpeco.trace_px = @s xpeco.trace_px run function xpeco:bottle/thrown/trace_speed
    REPEAT (['x', 'y', 'z']) as a {
        eq @s xpeco.trace_p<%a%> = #c<%a%> xpeco.tmp
    }
}

function trace_speed {
    REPEAT (['x', 'y', 'z']) as a {
        eq @s xpeco.trace_v<%a%> = #c<%a%> xpeco.tmp - @s xpeco.trace_p<%a%>
    }
}

function landed {
    # As and at a tracker whose bottle is gone
    execute as @a[distance=..3,scores={xpeco.bottle_prev=0..}] run function xpeco:bottle/thrown/take_back
    # Orbs from other bottles of ours carry xpeco.orb and stay
    kill @e[type=minecraft:experience_orb,tag=!xpeco.orb,distance=..3]
    function xpeco:bottle/normal/normal
    scoreboard players set #left xpeco.tmp <%config.bottlePoints%>
    function xpeco:orbs/split
    kill @s
}

function tick xpeco:tick {
    execute as @e[type=minecraft:experience_bottle,tag=!xpeco.tracked_bottle,tag=!xpeco.ignored] at @s run function xpeco:bottle/thrown/classify
    execute as @e[type=minecraft:marker,tag=xpeco.bottle_tracker] at @s run function xpeco:bottle/thrown/check_tracker
    execute as @a[scores={xpeco.bottle_prev=0..}] at @s unless entity @e[type=minecraft:marker,tag=xpeco.bottle_tracker,distance=..4] run scoreboard players reset @s xpeco.bottle_prev
}

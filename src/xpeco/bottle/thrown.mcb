import ../../config.js

# Tracking of a thrown bottle. The throw reward in use launches a snowball with a marker riding it. While the marker has a
# vehicle the bottle is in flight; when it has none the snowball has landed, and exactly bottlePoints of orbs, split at
# random, appear at the marker. Nothing vanilla lands, so no vanilla orbs have to be removed or taken back. The orbs are
# tagged xpeco.orb by orbs, which keeps several bottles landing together apart from each other.

function load minecraft:load {
    REPEAT (['xpeco.trace_px', 'xpeco.trace_py', 'xpeco.trace_pz', 'xpeco.trace_vx', 'xpeco.trace_vy', 'xpeco.trace_vz']) as o {
        scoreboard objectives add <%o%> dummy
    }
}

function uninstall xpeco:uninstall {
    REPEAT (['xpeco.trace_px', 'xpeco.trace_py', 'xpeco.trace_pz', 'xpeco.trace_vx', 'xpeco.trace_vy', 'xpeco.trace_vz']) as o {
        scoreboard objectives remove <%o%>
    }
    kill @e[type=minecraft:marker,tag=xpeco.bottle_tracker]
}

function check_tracker {
    # As and at a tracker. A tracker with no vehicle means the snowball has landed.
    scoreboard players set #v xpeco.tmp 0
    execute on vehicle run scoreboard players set #v xpeco.tmp 1
    execute if score #v xpeco.tmp matches 0 run return run function xpeco:bottle/thrown/landed
    function xpeco:bottle/thrown/trace
}

function trace {
    # As the tracker. Position and speed are scores on the marker, in thousandths of a block, so the only entity NBT read per
    # tick is the position. Speed is the change since the last tick, so when the bottle lands it is the speed of its last
    # step.
    REPEAT ({x: 0, y: 1, z: 2}) as a, i {
        execute store result score #c<%a%> xpeco.tmp run data get entity @s Pos[<%i%>] 1000
    }
    execute if score @s xpeco.trace_px = @s xpeco.trace_px run function xpeco:bottle/thrown/trace_speed
    REPEAT (['x', 'y', 'z']) as a {
        eq @s xpeco.trace_p<%a%> = #c<%a%> xpeco.tmp
    }
}

function trace_speed {
    REPEAT (['x', 'y', 'z']) as a {
        eq @s xpeco.trace_v<%a%> = #c<%a%> xpeco.tmp - @s xpeco.trace_p<%a%>
    }
}

function landed {
    # As and at a tracker whose snowball is gone
    function xpeco:bottle/thrown/splash
    function xpeco:bottle/normal/normal
    function xpeco:bottle/clamp
    scoreboard players operation #left xpeco.tmp = #bottlepoints xpeco.cfg
    function xpeco:orbs/split
    kill @s
}

function splash {
    # What a vanilla experience bottle shows on landing, in two particle commands and a fifth of the particles: potion break item
    # particles, and a burst of water colored effect particles with random velocities. The sound is the same one.
    particle minecraft:item{item:{id:"minecraft:splash_potion"}} ~ ~ ~ 0 0 0 0.1 4
    particle minecraft:effect{color:[0.22,0.36,0.78]} ~ ~0.3 ~ 0.1 0.1 0.1 1.5 20
    playsound minecraft:entity.splash_potion.break neutral @a ~ ~ ~ 1 0.95
}

function tick xpeco:tick {
    execute as @e[type=minecraft:marker,tag=xpeco.bottle_tracker] at @s run function xpeco:bottle/thrown/check_tracker
}

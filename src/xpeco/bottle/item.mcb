import ../predicate.js
import ../../text/bottle.js

# What a filled bottle is: the loot table fill hands out, the two mode modifiers and the predicate for holding one. It is a
# poisonous potato dressed as an experience bottle. Standing it throws, sneaking it is consumed, see mode and use.

# One filled bottle, in throw mode. A loot table applies an item modifier through its root modifier key, not through a
# functions list; 26.3 has no reference function, and a bare id in functions did nothing.
loot_table filled {
    "pools": [
        {
            "rolls": 1,
            "entries": [
                {
                    "type": "minecraft:item",
                    "name": "minecraft:poisonous_potato"
                }
            ]
        }
    ],
    "modifier": "xpeco:bottle/item/mode/throw"
}

# Throw mode: consumed one tick after it is used, no animation, no burp. The burp comes from the food component alone, so it
# is removed here. custom_data goes through SNBT so the flag stays a byte.
item_modifier mode/throw {
    "type": "minecraft:sequence",
    "functions": [
        {
            "type": "minecraft:set_components",
            "components": {
                "minecraft:item_model": "minecraft:experience_bottle",
                "minecraft:enchantment_glint_override": true,
                "minecraft:item_name": {
                    "translate": "xpeco.bottle.name",
                    "fallback": "Filled Bottle o' Enchanting"
                },
                "minecraft:rarity": "common",
                "minecraft:lore": <%bottleText.lore%>,
                "!minecraft:food": {},
                "!minecraft:use_remainder": {},
                "minecraft:consumable": {
                    "consume_seconds": 0.05,
                    "animation": "none",
                    "sound": "minecraft:entity.experience_bottle.throw",
                    "has_consume_particles": false
                }
            }
        },
        {
            "type": "minecraft:set_lore",
            "lore": <%bottleText.modeThrowLore%>,
            "mode": "append"
        },
        {
            "type": "minecraft:set_custom_data",
            "tag": "{\"xpeco:bottle\":1b,mode:\"throw\"}"
        }
    ]
}

# Drink mode: the default 1.6 second drink, without particles. consume_seconds is left out because it is the default, and
# Scan flags a field written at its default. Kept as food so it can always be consumed and burps afterwards.
item_modifier mode/drink {
    "type": "minecraft:sequence",
    "functions": [
        {
            "type": "minecraft:set_components",
            "components": {
                "minecraft:item_model": "minecraft:experience_bottle",
                "minecraft:enchantment_glint_override": true,
                "minecraft:item_name": {
                    "translate": "xpeco.bottle.name",
                    "fallback": "Filled Bottle o' Enchanting"
                },
                "minecraft:rarity": "common",
                "minecraft:lore": <%bottleText.lore%>,
                "minecraft:use_remainder": {
                    "id": "minecraft:glass_bottle"
                },
                "minecraft:food": {
                    "nutrition": 0,
                    "saturation": 0.0,
                    "can_always_eat": true
                },
                "minecraft:consumable": {
                    "animation": "drink",
                    "sound": "minecraft:entity.generic.drink",
                    "has_consume_particles": false
                }
            }
        },
        {
            "type": "minecraft:set_lore",
            "lore": <%bottleText.modeDrinkLore%>,
            "mode": "append"
        },
        {
            "type": "minecraft:set_custom_data",
            "tag": "{\"xpeco:bottle\":1b,mode:\"drink\"}"
        }
    ]
}

# A player with a filled bottle in either hand
predicate holding {
    <%holdingBottle()%>
}

import ../predicate.js
import ./modes.js

# What a filled bottle is: the loot table fill hands out, the two mode modifiers and the predicate for holding one. It is a
# poisonous potato dressed as an experience bottle. Standing it throws, sneaking it is consumed, see mode and use. The
# modifiers are built in modes.js, since the fill and the mode swaps share most of their parts.
#
# Lore lines: 1 and 2 the keys, 3 the points it was filled with, 4 the mode. The swaps replace line 4 only.

# One filled bottle, in throw mode, with the price stored in custom_data and in the lore. A loot table applies an item
# modifier through its root modifier key, not through a functions list; 26.3 has no reference function, and a bare id
# in functions did nothing.
loot_table filled {
    "pools": [
        {
            "rolls": 1,
            "entries": [
                {
                    "type": "minecraft:item",
                    "name": "minecraft:poisonous_potato"
                }
            ]
        }
    ],
    "modifier": "xpeco:bottle/item/fill"
}

# Each is a sequence of the functions modes.js builds under the key
REPEAT ([{path: 'fill', key: 'fill'}, {path: 'legacy', key: 'legacy'}, {path: 'mode/throw', key: 'throw'}, {path: 'mode/drink', key: 'drink'}]) as m {
    item_modifier <%m.path%> {
        "type": "minecraft:sequence",
        "functions": <%modes[m.key]%>
    }
}

# Takes one bottle out of the stack in hand. clear would take from the first stack in the inventory instead.
item_modifier use_one {
    "type": "minecraft:set_count",
    "count": -1,
    "add": true
}

# A player with a filled bottle in either hand
predicate holding {
    <%holdingBottle()%>
}

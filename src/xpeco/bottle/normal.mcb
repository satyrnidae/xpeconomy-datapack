# Surface normal of the impact, for orb motion. See the comment on normal.

# Surface normal of the impact, in #nx #ny #nz. Vanilla uses the face that was hit for blocks and the reverse of the
# motion of the bottle for entities. A datapack gets neither, so probe a bit past the marker along each axis the bottle
# was moving on: a solid block there is the face, and the normal points back against the travel. With nothing solid found
# it was an entity hit or a graze, so use the reverse of the motion; with no motion either, up.
function normal {
    scoreboard players set #nx xpeco.tmp 0
    scoreboard players set #ny xpeco.tmp 0
    scoreboard players set #nz xpeco.tmp 0
    scoreboard players set #vx xpeco.tmp 0
    scoreboard players set #vy xpeco.tmp 0
    scoreboard players set #vz xpeco.tmp 0
    execute store result score #vx xpeco.tmp run data get entity @s data.vx
    execute store result score #vy xpeco.tmp run data get entity @s data.vy
    execute store result score #vz xpeco.tmp run data get entity @s data.vz
    # The marker trails the impact by up to a step, so the probe goes 1.1 steps ahead. Speeds under 0.02 are ignored.
    execute unless score #vx xpeco.tmp matches -19..19 run function xpeco:bottle/normal/probe_x
    execute unless score #vy xpeco.tmp matches -19..19 run function xpeco:bottle/normal/probe_y
    execute unless score #vz xpeco.tmp matches -19..19 run function xpeco:bottle/normal/probe_z
    execute if score #nx xpeco.tmp matches 0 if score #ny xpeco.tmp matches 0 if score #nz xpeco.tmp matches 0 run function xpeco:bottle/normal/normal_from_motion
}

function probe_x {
    execute store result storage xpeco:tmp dx double 0.0011 run scoreboard players get #vx xpeco.tmp
    function xpeco:bottle/normal/probe_x_at with storage xpeco:tmp
}

function probe_x_at {
    $execute positioned ~$(dx) ~ ~ unless block ~ ~ ~ #xpeco:target/ray_pass run function xpeco:bottle/normal/hit_x
}

function hit_x {
    execute if score #vx xpeco.tmp matches 1.. run scoreboard players set #nx xpeco.tmp -1
    execute if score #vx xpeco.tmp matches ..-1 run scoreboard players set #nx xpeco.tmp 1
}

function probe_y {
    execute store result storage xpeco:tmp dy double 0.0011 run scoreboard players get #vy xpeco.tmp
    function xpeco:bottle/normal/probe_y_at with storage xpeco:tmp
}

function probe_y_at {
    $execute positioned ~ ~$(dy) ~ unless block ~ ~ ~ #xpeco:target/ray_pass run function xpeco:bottle/normal/hit_y
}

function hit_y {
    execute if score #vy xpeco.tmp matches 1.. run scoreboard players set #ny xpeco.tmp -1
    execute if score #vy xpeco.tmp matches ..-1 run scoreboard players set #ny xpeco.tmp 1
}

function probe_z {
    execute store result storage xpeco:tmp dz double 0.0011 run scoreboard players get #vz xpeco.tmp
    function xpeco:bottle/normal/probe_z_at with storage xpeco:tmp
}

function probe_z_at {
    $execute positioned ~ ~ ~$(dz) unless block ~ ~ ~ #xpeco:target/ray_pass run function xpeco:bottle/normal/hit_z
}

function hit_z {
    execute if score #vz xpeco.tmp matches 1.. run scoreboard players set #nz xpeco.tmp -1
    execute if score #vz xpeco.tmp matches ..-1 run scoreboard players set #nz xpeco.tmp 1
}

function normal_from_motion {
    scoreboard players operation #nx xpeco.tmp -= #vx xpeco.tmp
    scoreboard players operation #ny xpeco.tmp -= #vy xpeco.tmp
    scoreboard players operation #nz xpeco.tmp -= #vz xpeco.tmp
    execute if score #nx xpeco.tmp matches 0 if score #ny xpeco.tmp matches 0 if score #nz xpeco.tmp matches 0 run scoreboard players set #ny xpeco.tmp 1
}

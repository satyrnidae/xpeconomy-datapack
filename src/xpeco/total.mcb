import ../config.js
import ./levels.js

function load minecraft:load {
    scoreboard objectives add xpeco.lvl dummy
    scoreboard objectives add xpeco.pts dummy
    scoreboard objectives add xpeco.total dummy
}

function uninstall xpeco:uninstall {
    scoreboard objectives remove xpeco.lvl
    scoreboard objectives remove xpeco.pts
    scoreboard objectives remove xpeco.total
}

function compute {
    # Raw point total into @s xpeco.total, from level and progress points
    execute store result score @s xpeco.lvl run experience query @s levels
    function xpeco:total/points
    execute if score @s xpeco.lvl matches ..16 run function xpeco:total/low
    execute if score @s xpeco.lvl matches 17..31 run function xpeco:total/mid
    execute if score @s xpeco.lvl matches 32.. run function xpeco:total/high
    scoreboard players operation @s xpeco.total += @s xpeco.pts
}

function points {
    # Progress points into @s xpeco.pts, rounded to the nearest whole point. experience query points floors a float, and
    # every orb picked up adds a little float error, so a true 37 can read 36 and each death or pickup would lose a point for
    # good. XpP is read in ten thousandths, which is exact enough to round from below a level cost of a few thousand.
    execute store result score #xpp xpeco.tmp run data get entity @s XpP 10000
    REPEAT (levelTiers) as t {
        execute if score @s xpeco.lvl matches <%t.range%> run return run function xpeco:total/points_<%t.name%>
    }
}

# Points a level costs to finish, the tiers are in levels.js
REPEAT (levelTiers) as t {
    function points_<%t.name%> {
        eq @s xpeco.pts = (#xpp xpeco.tmp * (<%cost(t, '@s xpeco.lvl')%>) + 5000) / 10000
    }
}

function high {
    # (9L^2 - 325L + 4440) / 2
    eq @s xpeco.total = (@s xpeco.lvl * @s xpeco.lvl * 9 - @s xpeco.lvl * 325 + 4440) / 2
}

function low {
    # L^2 + 6L
    eq @s xpeco.total = @s xpeco.lvl * @s xpeco.lvl + @s xpeco.lvl * 6
}

function mid {
    # (5L^2 - 81L + 720) / 2
    eq @s xpeco.total = (@s xpeco.lvl * @s xpeco.lvl * 5 - @s xpeco.lvl * 81 + 720) / 2
}

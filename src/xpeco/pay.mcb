import ../text/pay.js
import ../config.js
import predicate.js

# /trigger pay set <amount> while looking at the target player
function load minecraft:load {
    scoreboard objectives add pay trigger
}

function uninstall xpeco:uninstall {
    scoreboard objectives remove pay
}

function run {
    # As and at the payer; the trigger score is the amount. A negative one is dropped.
    execute if score @s pay matches ..-1 run return run scoreboard players set @s pay 0
    scoreboard players operation #amt xpeco.tmp = @s pay
    scoreboard players set @s pay 0
    # Denied up front when the payer cannot cover it, before a target or a confirm prompt. The transfer checks again, since
    # the balance can change while the prompt is open.
    function xpeco:total/compute
    execute if score @s xpeco.total < #amt xpeco.tmp run return run tellraw @s <%payText.insufficient%>
    # The amount waits for a confirmation. A player in the crosshair is the target; otherwise a list of accounts is offered.
    scoreboard players operation @s xpeco.pay.amt = #amt xpeco.tmp
    execute store result score @s xpeco.pay.at run time query gametime
    scoreboard players set @s xpeco.pay.to 0
    scoreboard players set @s xpeco.pay.page 1
    function xpeco:target/find
    execute if entity @a[tag=xpeco.target] run scoreboard players operation @s xpeco.pay.to = @a[tag=xpeco.target,limit=1] xpeco.account
    tag @a remove xpeco.target
    execute if score @s xpeco.pay.to matches 1.. run return run function xpeco:paylist/confirm/prompt
    function xpeco:paylist/list/show
}

function offline {
    # As the payer, with #amt and #to (the target account) set. Pays an account that is not online through the pending ledger.
    function xpeco:total/compute
    execute if score @s xpeco.total < #amt xpeco.tmp run return run tellraw @s <%payText.insufficient%>
    data remove storage xpeco:tmp name
    execute store result storage xpeco:tmp id int 1 run scoreboard players get #to xpeco.tmp
    execute store result storage xpeco:tmp amount int 1 run scoreboard players get #amt xpeco.tmp
    function xpeco:pay/offline_name with storage xpeco:tmp
    execute unless data storage xpeco:tmp name run return run tellraw @s <%payText.unknown%>
    function xpeco:pay/offline_credit with storage xpeco:tmp
}

function offline_name {
    $data modify storage xpeco:tmp name set from storage xpeco:accounts list[{id:$(id)}].name
}

function offline_credit {
    $experience add @s -$(amount) points
    $scoreboard players add $(name) xpeco.pending $(amount)
    $tellraw @s <%payText.sentTo%>
}

function transfer {
    # As the payer, with the receiver tagged xpeco.target and #amt set. Overpay is blocked here, before anything moves.
    function xpeco:total/compute
    execute if score @s xpeco.total < #amt xpeco.tmp run return run tellraw @s <%payText.insufficient%>
    execute store result storage xpeco:tmp amount int 1 run scoreboard players get #amt xpeco.tmp
    function xpeco:pay/move with storage xpeco:tmp
    tellraw @s <%payText.sent%>
    tellraw @a[tag=xpeco.target,limit=1] <%payText.received%>
}

function move {
    $experience add @s -$(amount) points
    $experience add @a[tag=xpeco.target,limit=1] $(amount) points
}

predicate fired {
    <%nonzero(['pay'])%>
}

function tick xpeco:tick {
    execute as @a[predicate=xpeco:pay/fired] at @s run function xpeco:pay/run
}

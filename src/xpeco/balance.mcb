import ../config.js

# /trigger balance
function load minecraft:load {
    scoreboard objectives add balance trigger
}

function on_uninstall xpeco:on_uninstall {
    scoreboard objectives remove balance
}

function run {
    # Run as the player who fired the trigger
    scoreboard players set @s balance 0
    function xpeco:total/compute
    execute if score #mode xpeco.cfg matches 0 run tellraw @s {translate:"xpeco.balance.points",fallback:"Balance: %s points",with:[{score:{name:"@s",objective:"xpeco.total"}}]}
    execute if score #mode xpeco.cfg matches 1 run tellraw @s {translate:"xpeco.balance.levels",fallback:"Balance: %s levels",with:[{score:{name:"@s",objective:"xpeco.lvl"}}]}
    execute if score #mode xpeco.cfg matches 2 run function xpeco:balance/hundred
}

function hundred_calc {
    # As a player with xpeco.total set. Whole hundreds in #w, the two digit remainder in #f.
    scoreboard players operation #w xpeco.tmp = @s xpeco.total
    scoreboard players operation #w xpeco.tmp /= #100 xpeco.tmp
    scoreboard players operation #f xpeco.tmp = @s xpeco.total
    scoreboard players operation #f xpeco.tmp %= #100 xpeco.tmp
}

# Balance of any player the selector matches, op only because /function needs permission level 2.
# Usage: /function xpeco:balance/of {target:"@a[name=Steve]"}
# The selector runs from the op, so @p, @a[distance=..10] and the like work. Online players only: an offline balance is not
# readable from a datapack.
function of {
    tag @s add xpeco.asker
    $execute as $(target) run function xpeco:balance/of_one
    $execute unless entity $(target) run tellraw @s {translate:"xpeco.balance.nomatch",fallback:"No online player matches $(target)."}
    tag @s remove xpeco.asker
}

function of_one {
    # As the matched player, answering the op tagged xpeco.asker
    function xpeco:total/compute
    execute if score #mode xpeco.cfg matches 0 run tellraw @a[tag=xpeco.asker] {translate:"xpeco.balance.other.points",fallback:"%s: %s points",with:[{selector:"@s"},{score:{name:"@s",objective:"xpeco.total"}}]}
    execute if score #mode xpeco.cfg matches 1 run tellraw @a[tag=xpeco.asker] {translate:"xpeco.balance.other.levels",fallback:"%s: %s levels",with:[{selector:"@s"},{score:{name:"@s",objective:"xpeco.lvl"}}]}
    execute if score #mode xpeco.cfg matches 2 run function xpeco:balance/of_hundred
}

function of_hundred {
    function xpeco:balance/hundred_calc
    execute if score #f xpeco.tmp matches ..9 run tellraw @a[tag=xpeco.asker] {translate:"xpeco.balance.other.hundred",fallback:"%s: %s.0%s hundreds",with:[{selector:"@s"},{score:{name:"#w",objective:"xpeco.tmp"}},{score:{name:"#f",objective:"xpeco.tmp"}}]}
    execute if score #f xpeco.tmp matches 10.. run tellraw @a[tag=xpeco.asker] {translate:"xpeco.balance.other.hundred",fallback:"%s: %s.%s hundreds",with:[{selector:"@s"},{score:{name:"#w",objective:"xpeco.tmp"}},{score:{name:"#f",objective:"xpeco.tmp"}}]}
}

function hundred {
    function xpeco:balance/hundred_calc
    execute if score #f xpeco.tmp matches ..9 run tellraw @s {translate:"xpeco.balance.hundred",fallback:"Balance: %s.0%s hundreds",with:[{score:{name:"#w",objective:"xpeco.tmp"}},{score:{name:"#f",objective:"xpeco.tmp"}}]}
    execute if score #f xpeco.tmp matches 10.. run tellraw @s {translate:"xpeco.balance.hundred",fallback:"Balance: %s.%s hundreds",with:[{score:{name:"#w",objective:"xpeco.tmp"}},{score:{name:"#f",objective:"xpeco.tmp"}}]}
}

function tick minecraft:tick {
    scoreboard players enable @a balance
    execute as @a[scores={balance=1..}] run function xpeco:balance/run
}

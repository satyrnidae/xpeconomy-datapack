import ../text/balance.js
import ../config.js

# /trigger balance
function load minecraft:load {
    scoreboard objectives add balance trigger
}

function on_uninstall xpeco:on_uninstall {
    scoreboard objectives remove balance
}

function run {
    # Run as the player who fired the trigger
    scoreboard players set @s balance 0
    function xpeco:total/compute
    execute if score #mode xpeco.cfg matches 0 run tellraw @s <%balanceText.points%>
    execute if score #mode xpeco.cfg matches 1 run tellraw @s <%balanceText.levels%>
    execute if score #mode xpeco.cfg matches 2 run function xpeco:balance/hundred
}

function hundred_calc {
    # As a player with xpeco.total set. Whole hundreds in #w, the two digit remainder in #f.
    eq #w xpeco.tmp = @s xpeco.total / 100
    eq #f xpeco.tmp = @s xpeco.total % 100
}

# Balance of an online player, op only because /function needs permission level 2. The macro arguments are the NBT of the
# entity given to with, so UUID picks the player out again. Offline balances are not readable from a datapack.
# Usage: /function xpeco:balance/of with entity Steve
# Any selector that resolves to one entity works, so @p and @n[distance=..10] do too. An entity that is not a player
# gets the no match message.
function of {
    tag @s add xpeco.asker
    $execute as @a[nbt={UUID:$(UUID)}] run function xpeco:balance/of_one
    $execute unless entity @a[nbt={UUID:$(UUID)}] run tellraw @s <%balanceText.nomatch%>
    tag @s remove xpeco.asker
}

function of_one {
    # As the matched player, answering the op tagged xpeco.asker. Always points and whole levels, whatever the mode is.
    function xpeco:total/compute
    tellraw @a[tag=xpeco.asker] <%balanceText.other%>
}

function hundred {
    function xpeco:balance/hundred_calc
    execute if score #f xpeco.tmp matches ..9 run tellraw @s <%balanceText.hundredLow%>
    execute if score #f xpeco.tmp matches 10.. run tellraw @s <%balanceText.hundred%>
}

function tick xpeco:tick {
    execute as @a[scores={balance=1..}] run function xpeco:balance/run
}
